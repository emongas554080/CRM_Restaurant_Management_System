{
  "openapi": "3.1.1",
  "info": {
    "title": "CRM.api | v1",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:5080"
    }
  ],
  "paths": {
    "/api/DataCollection/tenants": {
      "get": {
        "tags": [
          "DataCollection"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/DataCollection/{tenantCode}/customers": {
      "post": {
        "tags": [
          "DataCollection"
        ],
        "parameters": [
          {
            "name": "tenantCode",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CustomerDto"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/CustomerDto"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/CustomerDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "get": {
        "tags": [
          "DataCollection"
        ],
        "parameters": [
          {
            "name": "tenantCode",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/DataCollection/{tenantCode}/customers/{id}": {
      "put": {
        "tags": [
          "DataCollection"
        ],
        "parameters": [
          {
            "name": "tenantCode",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CustomerDto"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/CustomerDto"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/CustomerDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "delete": {
        "tags": [
          "DataCollection"
        ],
        "parameters": [
          {
            "name": "tenantCode",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/DataCollection/all": {
      "get": {
        "tags": [
          "DataCollection"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CustomerDto": {
        "type": "object",
        "properties": {
          "fullName": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "phoneNumber": {
            "type": "string"
          },
          "address": {
            "type": "string"
          },
          "customerType": {
            "type": "string"
          },
          "favoriteFood": {
            "type": "string"
          },
          "visitFrequency": {
            "type": "string"
          },
          "feedback": {
            "type": "string"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "DataCollection"
    }
  ]
}